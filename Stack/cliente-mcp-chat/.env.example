# Modelo remoto que implemente la Messages API de Anthropic (vLLM la implementa).
# El SDK de Anthropic agrega /v1/messages: la URL va SIN /v1.
ANTHROPIC_BASE_URL=http://<ip-tailscale>:18020
# Obligatoria para el SDK: si el servidor no valida clave, poner cualquier valor.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# true deja que modelos tipo Qwen3 razonen antes de responder (más lento)
ENABLE_THINKING=false

# Servidor MCP
MCP_URL=http://sensorhub_mcp:8000/mcp
# Mismo valor que MCP_AUTH_TOKEN en MCP/.env
MCP_AUTH_TOKEN=
