## ------------------------------------------------------------------------------
## Regla y Acción para Disponibilidad y LWT de Dispositivos (Status)
## El mensaje de Last Will (online=false) lo publica el propio broker con un
## payload fijado al conectar, por lo que nunca trae un "ts" útil (reflejaría
## el momento de conexión, no el de la caída real). El coalesce() de abajo
## cubre ese caso con la hora de EMQX al detectar la desconexión.
## ------------------------------------------------------------------------------
actions {
  http {
    influx_status {
      connector = influxdb
      enable = true
      parameters {
        method = post
        path = "/api/v2/write?org=${INFLUXDB_ORG}&bucket=${INFLUXDB_BUCKET}&precision=ms"
        headers {
          Authorization = "Token ${INFLUXDB_ADMIN_TOKEN}"
          Content-Type = "text/plain; charset=utf-8"
        }
        body = "device_status,device_type=${device_type},device_id=${device_id} online=${online},value=${value}i ${ts}"
      }
    }
  }
}

rule_engine {
  rules {
    rule_sensorhub_status {
      sql = "SELECT nth(2, split(topic, '/')) as device_type, nth(3, split(topic, '/')) as device_id, clientid as client_id, payload.online as online, (CASE WHEN payload.online = true THEN 1 ELSE 0 END) as value, coalesce(payload.ts, now_timestamp('millisecond')) as ts FROM \"sensorhub/+/+/status\""
      enable = true
      description = "Registro de presencia y disponibilidad (LWT) hacia InfluxDB"
      actions = [
        "http:influx_status"
      ]
    }
  }
}

