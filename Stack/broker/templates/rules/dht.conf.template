## ------------------------------------------------------------------------------
## Regla y Acción para Sensor de Clima (DHT11/DHT22)
## ------------------------------------------------------------------------------
actions {
  http {
    influx_dht {
      connector = influxdb
      enable = true
      parameters {
        method = post
        path = "/api/v2/write?org=${INFLUXDB_ORG}&bucket=${INFLUXDB_BUCKET}&precision=s"
        headers {
          Authorization = "Token ${INFLUXDB_ADMIN_TOKEN}"
          Content-Type = "text/plain; charset=utf-8"
        }
        body = "dht_telemetry,device_type=${device_type},device_id=${device_id} temperature=${temperature},humidity=${humidity}"
      }
    }
  }
}

rule_engine {
  rules {
    rule_sensorhub_dht {
      sql = "SELECT nth(2, split(topic, '/')) as device_type, nth(3, split(topic, '/')) as device_id, clientid as client_id, payload.temperature as temperature, payload.humidity as humidity FROM \"sensorhub/dht/+/telemetry\""
      enable = true
      description = "Extracción de telemetría climática (DHT11/DHT22) hacia InfluxDB"
      actions = [
        "http:influx_dht"
      ]
    }
  }
}

