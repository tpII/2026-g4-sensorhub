## ------------------------------------------------------------------------------
## Regla y Acción para Actuador (Switch / Relé / Iluminación)
## ------------------------------------------------------------------------------
actions {
  http {
    influx_switch {
      connector = influxdb
      enable = true
      parameters {
        method = post
        path = "/api/v2/write?org=${INFLUXDB_ORG}&bucket=${INFLUXDB_BUCKET}&precision=ns"
        headers {
          Authorization = "Token ${INFLUXDB_ADMIN_TOKEN}"
          Content-Type = "text/plain; charset=utf-8"
        }
        body = "switch_telemetry,device_type=${device_type},device_id=${device_id} state=\"${state}\",value=${value}i"
      }
    }
  }
}

rule_engine {
  rules {
    rule_sensorhub_switch {
      sql = "SELECT nth(2, split(topic, '/')) as device_type, nth(3, split(topic, '/')) as device_id, clientid as client_id, payload.state as state, (CASE WHEN payload.state = 'on' THEN 1 ELSE 0 END) as value FROM \"sensorhub/switch/+/telemetry\""
      enable = true
      description = "Extracción de acuse de estado de actuadores (Switch) hacia InfluxDB"
      actions = [
        "http:influx_switch"
      ]
    }
  }
}

