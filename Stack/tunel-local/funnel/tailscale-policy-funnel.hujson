// ==============================================================================
// SensorHub - Política de tailnet con Funnel (tunel-local/docker-compose.funnel.yml)
// POLÍTICA COMPLETA, alternativa a sv-publico/tailscale-policy.hujson: es la
// misma más el atributo "funnel" para tag:servicios. Tailscale admite una sola
// política por tailnet, así que se pega esta O la otra en Access controls.
// Además hay que habilitar HTTPS en el panel → DNS → HTTPS Certificates.
// ==============================================================================
{
	// Quién puede crear auth keys con cada tag
	"tagOwners": {
		"tag:sv-publico": ["autogroup:admin"],
		"tag:servicios":  ["autogroup:admin"],
	},

	// Permite a las PCs con tag:servicios exponer servicios a internet con Funnel
	"nodeAttrs": [
		{
			"target": ["tag:servicios"],
			"attr":   ["funnel"],
		},
	],

	"grants": [
		// El servidor público solo llega al 443 (Traefik) de cada PC con servicios.
		// Nada más está permitido: las PCs no se ven entre sí ni pueden llegar
		// al servidor público.
		{
			"src": ["tag:sv-publico"],
			"dst": ["tag:servicios"],
			"ip":  ["tcp:443"],
		},
	],
}
