# ==============================================================================
# SensorHub - Túnel local (cliente Tailscale + Traefik)
# Copiar a .env y completar.
# ==============================================================================

# Dominios que atiende esta máquina (los que le asigna sv-publico/rutas.conf)
MCP_DOMAIN=mcp.ejemplo.com
MQTT_DOMAIN=mqtt.ejemplo.com
MCP_HTTP_PATH=/mcp
# Keycloak, el servidor de autorización del MCP (AUTH_PUBLIC_URL y KC_REALM de MCP/.env)
AUTH_DOMAIN=auth.ejemplo.com
KC_REALM=sensorhub

# Auth key con el tag "tag:servicios" (ver README). Solo se usa en el primer
# arranque; después la identidad queda en el volumen sensorhub_ts_local_state
TS_AUTHKEY=

# Nombre de esta máquina en la tailnet: el que se usa en sv-publico/rutas.conf.
# Distinto en cada PC (leno, pc-2, ...)
TS_HOSTNAME=leno

# Contacto para Let's Encrypt (avisos de vencimiento)
ACME_EMAIL=

# Certificado comodín *.CERT_DOMAIN, por desafío DNS en Cloudflare. MCP_DOMAIN,
# MQTT_DOMAIN y AUTH_DOMAIN tienen que ser subdominios directos de este dominio
CERT_DOMAIN=ejemplo.com
# Token de la API de Cloudflare con permisos Zone:Read y DNS:Edit sobre la zona
# del dominio (ver README)
CF_DNS_API_TOKEN=
# Para probar sin gastar los límites de Let's Encrypt: el entorno de staging
# (emite certificados que los clientes no aceptan). Al pasar a producción,
# comentarlo y borrar acme.json (ver README)
# ACME_CA_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory

TAILSCALE_IMAGE=tailscale/tailscale:v1.104.4
TRAEFIK_IMAGE=traefik:v3.3.5
