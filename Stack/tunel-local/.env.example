# ==============================================================================
# SensorHub - Túnel (cliente Tailscale + Funnel)
# Copiar a .env y completar.
# ==============================================================================

# Auth key con el tag "tag:servicios" (ver README). Solo se usa en el primer
# arranque; después la identidad queda en el volumen sensorhub_ts_local_state
TS_AUTHKEY=

# Nombre de esta máquina en la tailnet: define la URL pública
# https://<TS_HOSTNAME>.<tailnet>.ts.net
TS_HOSTNAME=sensorhub

TAILSCALE_IMAGE=tailscale/tailscale:v1.104.4
