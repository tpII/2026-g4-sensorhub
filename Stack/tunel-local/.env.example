# ==============================================================================
# SensorHub - Túnel local (cliente Tailscale + Traefik)
# Copiar a .env y completar.
# ==============================================================================

# Dominios que atiende esta máquina (los que le asigna sv-publico/rutas.conf)
MCP_DOMAIN=mcp.ejemplo.com
MQTT_DOMAIN=mqtt.ejemplo.com
MCP_HTTP_PATH=/mcp

# Auth key con el tag "tag:servicios" (ver README). Solo se usa en el primer
# arranque; después la identidad queda en el volumen sensorhub_ts_local_state
TS_AUTHKEY=

# Nombre de esta máquina en la tailnet: el que se usa en sv-publico/rutas.conf.
# Distinto en cada PC (leno, pc-2, ...)
TS_HOSTNAME=leno

# Contacto para Let's Encrypt (avisos de vencimiento)
ACME_EMAIL=

TAILSCALE_IMAGE=tailscale/tailscale:v1.104.4
TRAEFIK_IMAGE=traefik:v3.3.5
