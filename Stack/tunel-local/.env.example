# ==============================================================================
# SensorHub - Túnel local (cliente WireGuard + Traefik)
# Copiar a .env y completar. Las claves se generan como indica el README.
# ==============================================================================

# Dominios que atiende esta máquina (los mismos que le asigna sv-publico/rutas.conf)
MCP_DOMAIN=mcp.ejemplo.com
MQTT_DOMAIN=mqtt.ejemplo.com
MCP_HTTP_PATH=/mcp

# IP pública (o dominio con nube gris) y puerto UDP del servidor público
WG_ENDPOINT=203.0.113.10:51820

# Clave privada de ESTA PC (su pública va en sv-publico/peers.conf) y clave
# pública del servidor público
WG_PRIVATE_KEY=
WG_PEER_PUBLIC_KEY=

# Direcciones dentro del túnel: la de esta PC (la que tiene en
# sv-publico/peers.conf, distinta en cada máquina) y la del servidor
WG_ADDRESS=10.13.13.2
WG_PEER_ADDRESS=10.13.13.1

# Contacto para Let's Encrypt (avisos de vencimiento)
ACME_EMAIL=

TRAEFIK_IMAGE=traefik:v3.3.5
