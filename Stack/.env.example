# ==============================================================================
# SensorHub Stack - Variables de Entorno del Broker EMQX
#
# Los valores por defecto de este archivo son para DESARROLLO LOCAL únicamente.
# Si el stack se expone fuera de la máquina de desarrollo, reemplazar todos los
# valores (credenciales y token de InfluxDB) en el .env real antes de levantarlo.
# ==============================================================================

# Imagen oficial de EMQX 5
EMQX_IMAGE=emqx/emqx:5.8.0

# Credenciales de acceso al Dashboard Web (http://<host>:18083)
EMQX_DASHBOARD__DEFAULT_USERNAME=admin
EMQX_DASHBOARD__DEFAULT_PASSWORD=admin

# Credenciales MQTT: EMQX rechaza a cualquier cliente sin usuario y contraseña.
# - ESP: compartido por todos los dispositivos (firmware y simuladores).
#   Va también en Firmware/sensorHub/main/app_config.h.
# - MCP: el servidor MCP (y el simulador que manda comandos). Va también en MCP/.env.
# Generar contraseñas largas, p. ej. con: openssl rand -hex 24
# (sin comas, comillas ni saltos de línea)
MQTT_ESP_USERNAME=esp
MQTT_ESP_PASSWORD=
MQTT_MCP_USERNAME=mcp
MQTT_MCP_PASSWORD=

# Puertos expuestos en el Host
EMQX_MQTT_PORT=1883
EMQX_MQTTS_PORT=8883
EMQX_WS_PORT=8083
EMQX_WSS_PORT=8084
EMQX_DASHBOARD_PORT=18083

# ==============================================================================
# InfluxDB 2 - Base de Datos de Series Temporales (Time-Series DB)
# ==============================================================================
INFLUXDB_IMAGE=influxdb:2.7-alpine
INFLUXDB_PORT=8086

# Parámetros de Bootstrap y Onboarding Automático en Frío
INFLUXDB_USERNAME=admin
INFLUXDB_PASSWORD=adminpassword123
INFLUXDB_ORG=sensorhub
INFLUXDB_BUCKET=sensorhub
INFLUXDB_RETENTION=0
INFLUXDB_ADMIN_TOKEN=sensorhub_admin_secret_token_123
