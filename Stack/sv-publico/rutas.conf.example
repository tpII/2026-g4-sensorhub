# ==============================================================================
# SensorHub - Qué máquina atiende cada dominio
# Copiar a rutas.conf. Una línea por dominio: dominio y nombre de la máquina
# en la tailnet (su TS_HOSTNAME). nginx reenvía, sin descifrar, cada conexión
# al 443 de esa máquina; un dominio que no está acá se descarta.
# Cada dominio necesita su registro A en Cloudflare (nube gris).
# ==============================================================================

# dominio               máquina
mcp.ejemplo.com         leno
mqtt.ejemplo.com        leno
mcp2.ejemplo.com        pc-2
mqtt2.ejemplo.com       pc-2
