# ==============================================================================
# SensorHub - Servidor público (cliente Tailscale + router SNI)
# Copiar a .env y completar. Los dominios van en rutas.conf.
# ==============================================================================

# Auth key con el tag "tag:sv-publico" (ver README). Solo se usa en el primer
# arranque; después la identidad queda en el volumen sensorhub_ts_publico_state
TS_AUTHKEY=

# Nombre de esta máquina en la tailnet
TS_HOSTNAME=toshi

# Dominio de la tailnet (panel de Tailscale → DNS → "Tailnet name")
TS_TAILNET=tailXXXX.ts.net

TAILSCALE_IMAGE=tailscale/tailscale:v1.104.4
NGINX_IMAGE=nginx:1.27.4-alpine
