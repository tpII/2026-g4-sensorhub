# ==============================================================================
# SensorHub - Servidor público (servidor WireGuard + router SNI)
# Copiar a .env y completar. Las claves se generan como indica el README.
# Las máquinas y sus dominios van en peers.conf y rutas.conf.
# ==============================================================================

# Clave privada de ESTE SERVIDOR
WG_PRIVATE_KEY=

# Dirección del servidor dentro del túnel (WG_PEER_ADDRESS de cada tunel-local)
WG_ADDRESS=10.13.13.1

# Puerto UDP del túnel (el estándar de WireGuard)
WG_LISTEN_PORT=51820

NGINX_IMAGE=nginx:1.27.4-alpine
