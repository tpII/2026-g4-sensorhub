# SensorHub - Simuladores MQTT
# Copiar a .env con los mismos valores de Stack/.env: los simuladores de
# dispositivos usan el usuario de los ESP y el que manda comandos, el del MCP.
MQTT_ESP_USERNAME=esp
MQTT_ESP_PASSWORD=
MQTT_MCP_USERNAME=mcp
MQTT_MCP_PASSWORD=

# ids que NO se simulan (separados por coma): los 3 nodos físicos "demo" que también
# figuran en MCP/devices.csv (dht, pir y switch). Vacío = se simulan todos.
EXCLUIR_IDS=983dae529858,0892728138ec,9454c5b096b0
