#ifndef SECRETS_H
#define SECRETS_H

// =============================================================================
// Credenciales del firmware. Copiar a secrets.h (ignorado por Git) y completar.
// Lo incluye app_config.h; el resto de la configuración sigue ahí.
// =============================================================================

// --- Credenciales WiFi ---
#define CONFIG_WIFI_SSID                "<ssid>"
#define CONFIG_WIFI_PASS                "<passwd>"

// --- Contraseña MQTT del usuario de los dispositivos ---
// MQTT_ESP_PASSWORD de Stack/.env (el usuario, CONFIG_MQTT_USERNAME, está en app_config.h)
#define CONFIG_MQTT_PASSWORD            "<mqtt_esp_password>"

#endif // SECRETS_H
