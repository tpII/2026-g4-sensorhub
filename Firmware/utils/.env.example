# Modelo / Target del microcontrolador (esp32, esp32s2, esp32s3, esp32c3, esp32c6, etc.)
TARGET=esp32c3

# Tipo de dispositivo a compilar (dht, pir, switch, etc.)
DEVICE_TYPE=dht

# Puerto serie del ESP
# Linux: /dev/ttyUSB0 o /dev/ttyACM0
# Verificacion rapida: ls -la /dev/ttyUSB* && ls -la /dev/ttyACM*
# Windows (WSL2 + usbipd): /dev/ttyUSB0 o /dev/ttyACM0
PORT=/dev/ttyACM0

# Baudrate para monitor serial
BAUD=115200

# Directorio del firmware a flashear (relativo a este docker-compose.yml)
PROJECT_DIR=../sensorHub

# Imagen oficial de ESP-IDF
IDF_IMAGE=espressif/idf:v5.2.2

