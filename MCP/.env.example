# SensorHub - Configuracion del Servidor MCP

# Broker MQTT (EMQX)
MQTT_BROKER_HOST=sensorhub_emqx
MQTT_BROKER_PORT=1883
# Usuario MQTT del MCP: los mismos MQTT_MCP_USERNAME / MQTT_MCP_PASSWORD de Stack/.env
MQTT_USERNAME=mcp
MQTT_PASSWORD=

# Base de datos de series temporales (InfluxDB v2)
INFLUXDB_URL=http://sensorhub_influxdb:8086
INFLUXDB_TOKEN=sensorhub_admin_secret_token_123
INFLUXDB_ORG=sensorhub
INFLUXDB_BUCKET=sensorhub

# Transporte y red del Servidor MCP (Streamable HTTP)
MCP_HOST=0.0.0.0
MCP_PORT=8000
MCP_HTTP_PATH=/mcp

# Modo stateless de Streamable HTTP para clientes de revisiones anteriores a
# 2026-07-28 (sin sesión: permite correr varias réplicas). Con "true", esos
# clientes no reciben elicitation en resolve_device_id; los clientes de la
# revisión 2026-07-28, que ya es sin estado, no se ven afectados.
MCP_STATELESS_HTTP=false

# Protección contra DNS rebinding (validación de Host y Origin). Se admite el
# comodín de puerto "host:*". Para exponer el servidor con un túnel (ngrok),
# agregar su dominio, p. ej. "abc123.ngrok-free.app" y "https://abc123.ngrok-free.app".
MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*,sensorhub_mcp:*
MCP_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*

# Autenticación OAuth 2.1 con Keycloak (servicios keycloak* del compose).
# Keycloak registra a los clientes (claude.ai, ChatGPT, Claude Code...), muestra
# el login y emite los tokens; el servidor MCP solo los verifica.
# Con "false" el servidor queda abierto (solo para desarrollo local).
MCP_AUTH_ENABLED=true

# URL pública del servidor, sin path: el endpoint queda en MCP_PUBLIC_URL + MCP_HTTP_PATH,
# que es la audiencia de los tokens
MCP_PUBLIC_URL=https://mcp.ejemplo.com
# URL pública de Keycloak, sin path (necesita su dominio en Stack/tunel-local y
# en sv-publico/rutas.conf). El issuer queda en AUTH_PUBLIC_URL/realms/KC_REALM
AUTH_PUBLIC_URL=https://auth.ejemplo.com

# Realm del MCP. Se importa de keycloak/realm-sensorhub.json la primera vez
# que arranca Keycloak; los usuarios se crean a mano desde la consola (ver
# keycloak/configurar-keycloak.md). El JSON crea el realm "sensorhub": si se
# cambia este valor, cambiar también "realm" en el JSON
KC_REALM=sensorhub
# Administrador de Keycloak (consola en http://localhost:KC_ADMIN_PORT, solo
# desde esta máquina). Se crea en el primer arranque; cambiarlo después acá no
# cambia la contraseña ya creada (eso se hace desde la consola)
KC_ADMIN_USERNAME=admin
KC_ADMIN_PASSWORD=
KC_ADMIN_PORT=8081
# Contraseña de la base de Keycloak (Postgres, volumen sensorhub_keycloak_db).
# Postgres la fija en el primer arranque, pero Keycloak la usa en cada arranque
# para conectarse: cambiarla solo acá deja a Keycloak sin poder arrancar. Para
# cambiarla, primero en Postgres y después acá:
#   docker exec -it sensorhub_keycloak_db psql -U keycloak -d keycloak -c "ALTER USER keycloak PASSWORD '<nueva>';"
KC_DB_PASSWORD=

# Registro de dispositivos para resolve_device_id (device_type,device_id,friendly_name)
# Opcional: por defecto usa devices.csv en la raíz de MCP/ (junto a este archivo).
# DEVICE_REGISTRY_PATH=/app/devices.csv

# Para el Inspector: resolver el dominio público a la IP local del servidor
# público (el router no hace NAT loopback). Solo necesario cuando se accede al MCP desde la misma red que el servidor público.
# Ademas modificar el /etc/hosts de la PC para poder acceder al MCP desde el navegador con el dominio público.
# Para ir directo al Traefik de esta máquina, sin el servidor público, usar
# MCP_PUBLIC_HOST_IP=host-gateway (con TRAEFIK_LOCAL_IP=0.0.0.0 en Stack/tunel-local/.env)
MCP_PUBLIC_HOST=mcp.ejemplo.com
AUTH_PUBLIC_HOST=auth.ejemplo.com
MCP_PUBLIC_HOST_IP=192.168.0.33 # IP privada del servidor público para pruebas internas
