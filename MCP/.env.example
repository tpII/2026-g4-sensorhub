# SensorHub - Configuracion del Servidor MCP

# Broker MQTT (EMQX)
MQTT_BROKER_HOST=sensorhub_emqx
MQTT_BROKER_PORT=1883
# Usuario MQTT del MCP: los mismos MQTT_MCP_USERNAME / MQTT_MCP_PASSWORD de Stack/.env
MQTT_USERNAME=mcp
MQTT_PASSWORD=

# Base de datos de series temporales (InfluxDB v2)
INFLUXDB_URL=http://sensorhub_influxdb:8086
INFLUXDB_TOKEN=sensorhub_admin_secret_token_123
INFLUXDB_ORG=sensorhub
INFLUXDB_BUCKET=sensorhub

# Transporte y red del Servidor MCP (Streamable HTTP)
MCP_HOST=0.0.0.0
MCP_PORT=8000
MCP_HTTP_PATH=/mcp

# Modo stateless de Streamable HTTP para clientes de revisiones anteriores a
# 2026-07-28 (sin sesión: permite correr varias réplicas). Con "true", esos
# clientes no reciben elicitation en resolve_device_id; los clientes de la
# revisión 2026-07-28, que ya es sin estado, no se ven afectados.
MCP_STATELESS_HTTP=false

# Protección contra DNS rebinding (validación de Host y Origin). Se admite el
# comodín de puerto "host:*". Para exponer el servidor con un túnel (ngrok),
# agregar su dominio, p. ej. "abc123.ngrok-free.app" y "https://abc123.ngrok-free.app".
MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*,sensorhub_mcp:*
MCP_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*

# Registro de dispositivos para resolve_device_id (device_type,device_id,friendly_name)
# Opcional: por defecto usa devices.csv en la raíz de MCP/ (junto a este archivo).
# DEVICE_REGISTRY_PATH=/app/devices.csv
